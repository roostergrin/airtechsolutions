.hero-main(:class="{ 'hero-main--home': $route.path === '/', 'hero-main--no-image': !props.image.src && !props.video.src, 'hero-main--small-height': props.small, 'hero-main--has-service-icons': hasServiceIcons, 'hero-main--property-page': isPropertyPage, 'hero-main--about-page': isAboutPage }")
  .hero-main__overlay
  .hero-main__image-container(v-if='props.media_type === "image"')
    picture.hero-main__picture(ref='image')
      source(:srcset='webpSrc' type='image/webp')
      img.hero-main__image(:src='imgSrc', :alt='props.image.alt', :style='{ objectPosition: props.image.objectPosition ? props.image.objectPosition : null }' :aria-hidden='props.image.alt ? "false" : "true"')
  .hero-main__video(v-else-if='props.media_type === "video"')
    video.hero-main__video(:src='props.video.src' :title='props.video.title' autoplay muted playsinline loop ref='video')
      source(:src='props.video.webm', type='video/webm')
      source(:src='props.video.src', type='video/mp4')
    button.hero-main__video-control(v-if='videoPlaying' @click='pauseVideo' aria-label='pause hero video')
      BaseIcon.hero-main__video-control-pause(name='pause')
    button.hero-main__video-control(v-else-if='!videoPlaying' @click='playVideo' aria-label='play hero video')
      BaseIcon.hero-main__video-control-play(name='play')
  .hero-main__container
    .hero-main__content.hero-main__content--title-only(v-if='!props.text && $route.path === "/"')
      .hero-main__title.hero-main__title--logo(v-if='hasHeroLogo' ref='heroTitle')
        BaseIcon.hero-main__title-logo(:name='props.logo.name' aria-hidden='true')
      h1.hero-main__title(v-else ref='heroTitle' v-html='props.title')
      h1.hero-main__heading(v-if='hasHeroLogo && props.heading' v-html='props.heading')
      BlockButton.hero-main__cta(v-if='props.button.label', :props='props.button', :customization-section-key='customizationSectionKey', customization-key='primary-cta', ref='heroBtn', @click='handleCtaClick')
    .hero-main__content(v-else-if='props.text' :class='{ "hero-main__content--home": $route.path === "/" }')
      .hero-main__title.hero-main__title--small.hero-main__title--logo(v-if='hasHeroLogo' ref='heroTitle')
        BaseIcon.hero-main__title-logo(:name='props.logo.name' aria-hidden='true')
      h1.hero-main__title.hero-main__title--small(v-else ref='heroTitle' v-html='props.title')
      h1.hero-main__heading(v-if='hasHeroLogo && props.heading' v-html='props.heading')
      .hero-main__text(v-html='props.text' ref='heroText')
      .hero-main__ctas(v-if='props.button.label || (props.phone_button && props.phone_button.label)')
        BlockButton.hero-main__cta(v-if='props.button.label', :props='props.button', :customization-section-key='customizationSectionKey', customization-key='primary-cta', ref='heroBtn', @click='handleCtaClick')
        BlockButton.hero-main__cta(v-if='props.phone_button && props.phone_button.label', :props='props.phone_button', :customization-section-key='customizationSectionKey', customization-key='phone-cta')
    .hero-main__content.hero-main__content--pages(v-else-if='!props.text && $route.path !== "/"')
      .hero-main__title.hero-main__title--logo(v-if='hasHeroLogo' ref='heroTitle')
        BaseIcon.hero-main__title-logo(:name='props.logo.name' aria-hidden='true')
      h1.hero-main__title(v-else ref='heroTitle' v-html='props.title')
      h1.hero-main__heading(v-if='hasHeroLogo && props.heading' v-html='props.heading')
    .hero-main__service-icons(v-if='hasServiceIcons' aria-label='Commercial services')
      .hero-main__service-icons-track
        button.hero-main__service-icon(v-for='service in serviceIcons' :key='service.label' type='button' :aria-label='`View ${service.label}`' @click='handleServiceIconClick(service)')
          span.hero-main__service-icon-image(:style='{ "--service-icon-src": `url(${service.src})` }' aria-hidden='true')
          span.hero-main__service-icon-label(v-html='service.label')
    .hero-main__down(v-if="$route.path === '/' && !hasServiceIcons")
      BaseIcon.hero-main__down-icon(name='mouse')                 
